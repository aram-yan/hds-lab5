# raw inputs are copies of course-repo files; never committed (cohort.db is 16 MB)
# the empty data/raw/ folder is kept so the README's copy commands work on a fresh clone
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep
*.db
*.db-journal

# workflow bookkeeping and per-rule logs (evidence/ holds the kept console output)
.snakemake/
logs/

# python / jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# editors / os
.idea/
.vscode/
.DS_Store
Thumbs.db
